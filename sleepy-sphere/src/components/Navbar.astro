<header class="site-header">
  <a href="/" class="logo">
    <img src="/images/logo/logo.jpg" alt="West Cork Construction & Maintenance Ltd" />
    <span>West Cork Construction & Maintenance Ltd</span>
  </a>

  <nav>
    <a href="/">Home</a>
    <a href="/about">About</a>
    <a href="/services">Services</a>
    <a href="/renovations">Renovations</a>
    <a href="/roofing">Roofing</a>
    <a href="/property-maintenance">Property Maintenance</a>
    <a href="/extensions">Extensions</a>
    <a href="/builders-west-cork">Builders West Cork</a>
  </nav>
</header>

<style>
  .site-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 25px;
    padding: 15px 30px;
    background: #111;
  }

  .logo {
    display: flex;
    align-items: center;
    gap: 12px;
    color: white;
    text-decoration: none;
    font-weight: 700;
  }

  .logo img {
    width: 55px;
    height: 55px;
    object-fit: contain;
  }

  nav {
    display: flex;
    flex-wrap: wrap;
    gap: 18px;
  }

  nav a {
    color: white;
    text-decoration: none;
    font-weight: 600;
  }

  nav a:hover {
    color: #25d366;
  }

  @media (max-width: 900px) {
    .site-header {
      flex-direction: column;
    }

    nav {
      justify-content: center;
    }
  }
</style>