---
const {
  title = "West Cork Construction & Maintenance Ltd",
  description = "West Cork Construction & Maintenance Ltd — professional construction, roofing, renovation and property maintenance services throughout West Cork."
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
  </head>

  <body>
    <slot />
  </body>
</html>

<style>
  html,
  body {
    margin: 0;
    padding: 0;
    font-family: Arial, Helvetica, sans-serif;
  }

  body {
    background: #fff;
    color: #111;
  }
</style>