---
import Layout from "../layouts/Layout.astro";
import Navbar from "../components/Navbar.astro";
import Footer from "../components/Footer.astro";
---

<Layout
    title="Construction Services West Cork | West Cork Construction & Maintenance Ltd"
    description="Professional building, roofing, renovations, extensions and property maintenance services throughout West Cork."
>

<Navbar />

<main>

    <section class="hero">
        <h1>Our Construction Services</h1>
        <p>
            Professional building and property maintenance services
            throughout West Cork.
        </p>
    </section>

    <section class="services">

        <div class="service">
            <span>🏠</span>
            <h2>New Builds</h2>
            <p>Professional construction services for new homes and buildings.</p>
            <a href="/builders-west-cork">Learn More</a>
        </div>

        <div class="service">
            <span>🪜</span>
            <h2>Roofing</h2>
            <p>Roof repairs, new roofs, chimneys, gutters, fascias and soffits.</p>
        <a href="/roofing">Learn More</a>
        </div>

        <div class="service">
            <span>🔨</span>
            <h2>Renovations</h2>
            <p>Home renovations and property improvements from small jobs to larger projects.</p>
            <a href="/renovations">Learn More</a>
        </div>

        <div class="service">
            <span>🧱</span>
            <h2>Modern Extensions</h2>
            <p>Quality extensions designed to create more space and improve your home.</p>
            <a href="/extensions">Learn More</a>
        </div>

        <div class="service">
            <span>🧰</span>
            <h2>Property Maintenance</h2>
            <p>Reliable maintenance and repair services for homes and properties.</p>
            <a href="/property-maintenance">Learn More</a>
        </div>

        <div class="service">
            <span>🛠️</span>
            <h2>Other Services</h2>
            <p>Guttering, chimney repairs, waterproofing and general building work.</p>
            <a href="/contact">Request a Quote</a>
        </div>

    </section>

    <section class="cta">
        <h2>Have a Project in Mind?</h2>
        <p>Contact us today for a free, no-obligation quotation.</p>
        <a href="/contact" class="btn">Request a Free Quote</a>
    </section>

</main>

<Footer />

</Layout>

<style>
.hero{
    background:#111;
    color:#fff;
    text-align:center;
    padding:110px 10% 80px;
}

.hero h1{
    font-size:3rem;
    margin-bottom:20px;
}

.hero p{
    color:#ddd;
    font-size:1.15rem;
}

.services{
    max-width:1100px;
    margin:auto;
    padding:80px 10%;
    display:grid;
    grid-template-columns:repeat(3,1fr);
    gap:25px;
}

.service{
    padding:35px 25px;
    border:1px solid #eee;
    border-radius:10px;
    text-align:center;
    transition:.3s;
}

.service:hover{
    transform:translateY(-6px);
    box-shadow:0 15px 30px rgba(0,0,0,.12);
}

.service span{
    font-size:2.5rem;
}

.service h2{
    margin:15px 0;
}

.service p{
    color:#666;
    line-height:1.7;
}

.service a{
    color:#d97b18;
    font-weight:bold;
    text-decoration:none;
}

.cta{
    margin:20px 10% 80px;
    padding:60px 30px;
    text-align:center;
    background:#111;
    color:#fff;
    border-radius:10px;
}

.cta p{
    color:#ddd;
    margin-bottom:30px;
}

.btn{
    display:inline-block;
    background:#d97b18;
    color:#fff;
    text-decoration:none;
    padding:14px 30px;
    border-radius:6px;
    font-weight:bold;
}

@media(max-width:768px){
    .services{
        grid-template-columns:1fr;
    }

    .hero h1{
        font-size:2.2rem;
    }
}
</style>