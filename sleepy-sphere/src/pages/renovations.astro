---
import Layout from "../layouts/Layout.astro";
import Navbar from "../components/Navbar.astro";
import Footer from "../components/Footer.astro";
---

<Layout
    title="Home Renovations West Cork | West Cork Construction & Maintenance Ltd"
    description="Home renovation services throughout West Cork including property renovations, refurbishments, repairs and improvements."
>

<Navbar />

<main>

<section class="hero">
    <h1>Home Renovations in West Cork</h1>
    <p>
        Quality renovation and refurbishment work for homes and properties
        throughout West Cork.
    </p>
</section>

<section class="content">

    <h2>Professional Home Renovations</h2>

    <p>
        West Cork Construction & Maintenance Ltd provides professional
        renovation services for homeowners looking to improve, modernise
        or restore their property.
    </p>

    <p>
        Whether you are planning a single-room renovation or a larger
        property refurbishment, we provide reliable workmanship and
        attention to detail throughout the project.
    </p>

    <div class="services">

        <div>
            <h3>🏠 Full Home Renovations</h3>
            <p>
                Comprehensive renovation work to modernise and improve
                your home.
            </p>
        </div>

        <div>
            <h3>🔨 Structural & Building Work</h3>
            <p>
                General building and structural work as part of your
                renovation project.
            </p>
        </div>

        <div>
            <h3>🧱 Walls & Alterations</h3>
            <p>
                Internal alterations, walls and changes to existing spaces.
            </p>
        </div>

        <div>
            <h3>🏡 Exterior Renovations</h3>
            <p>
                Improvements and repairs to the exterior of your property.
            </p>
        </div>

        <div>
            <h3>🛠️ Property Improvements</h3>
            <p>
                Practical improvements designed to make your property
                more comfortable and functional.
            </p>
        </div>

        <div>
            <h3>✨ Refurbishments</h3>
            <p>
                Refresh and restore older properties with quality
                renovation work.
            </p>
        </div>

    </div>

    <h2>Renovation Services Across West Cork</h2>

    <p>
        We provide home renovation services throughout
        <strong>Clonakilty, Skibbereen, Rosscarbery, Dunmanway, Bandon,
        Glandore, Leap, Castletownshend and Enniskeane</strong> and
        surrounding areas.
    </p>

    <div class="cta">
        <h2>Planning a Home Renovation?</h2>

        <p>
            Get in touch with West Cork Construction & Maintenance Ltd
            for a free, no-obligation quotation.
        </p>

        <a href="/contact">Request a Free Quote</a>
    </div>

</section>

</main>

<Footer />

</Layout>

<style>
.hero{
    background:#111;
    color:#fff;
    text-align:center;
    padding:110px 10% 80px;
}

.hero h1{
    font-size:3rem;
    margin-bottom:20px;
}

.hero p{
    color:#ddd;
    font-size:1.2rem;
}

.content{
    max-width:1000px;
    margin:auto;
    padding:80px 10%;
}

.content h2{
    margin-top:45px;
    margin-bottom:20px;
    font-size:2rem;
}

.content p{
    line-height:1.8;
    color:#555;
}

.services{
    display:grid;
    grid-template-columns:repeat(2,1fr);
    gap:25px;
    margin-top:35px;
}

.services div{
    padding:30px;
    border:1px solid #eee;
    border-radius:10px;
}

.services h3{
    margin-top:0;
}

.cta{
    margin-top:60px;
    padding:50px 30px;
    background:#111;
    color:#fff;
    text-align:center;
    border-radius:10px;
}

.cta h2{
    margin-top:0;
}

.cta p{
    color:#ddd;
    margin-bottom:25px;
}

.cta a{
    display:inline-block;
    background:#d97b18;
    color:#fff;
    text-decoration:none;
    padding:14px 30px;
    border-radius:6px;
    font-weight:bold;
}

@media(max-width:700px){
    .services{
        grid-template-columns:1fr;
    }

    .hero h1{
        font-size:2.2rem;
    }
}
</style>