---
import Layout from "../layouts/Layout.astro";
import Navbar from "../components/Navbar.astro";
import Footer from "../components/Footer.astro";
---

<Layout
    title="House Extensions West Cork | West Cork Construction & Maintenance Ltd"
    description="Professional house extension services throughout West Cork. Create more space and add value to your home with a quality extension."
>

<Navbar />

<main>

<section class="hero">
    <h1>House Extensions in West Cork</h1>
    <p>
        Quality home extensions designed and built to give your family more space.
    </p>
</section>

<section class="content">

    <h2>Create More Space in Your Home</h2>

    <p>
        A well-planned extension can transform your home, giving you the
        additional space you need without having to move.
    </p>

    <p>
        West Cork Construction & Maintenance Ltd provides professional
        building services for home extensions throughout West Cork.
        We work with homeowners to deliver practical, high-quality
        extensions suited to their property and requirements.
    </p>

    <div class="services">

        <div>
            <h3>🏠 Home Extensions</h3>
            <p>
                Create additional living space with a professionally
                constructed extension.
            </p>
        </div>

        <div>
            <h3>🍽️ Kitchen Extensions</h3>
            <p>
                Expand your kitchen and create a larger, more practical
                space for everyday living.
            </p>
        </div>

        <div>
            <h3>🛋️ Living Spaces</h3>
            <p>
                Add comfortable new living areas designed around the way
                you use your home.
            </p>
        </div>

        <div>
            <h3>🛏️ Additional Bedrooms</h3>
            <p>
                Create extra bedroom space for a growing family or guests.
            </p>
        </div>

    </div>

    <h2>Extensions Throughout West Cork</h2>

    <p>
        We provide extension and building services throughout
        <strong>Clonakilty, Skibbereen, Rosscarbery, Dunmanway, Bandon,
        Glandore, Leap, Castletownshend and Enniskeane</strong> and
        surrounding areas.
    </p>

    <div class="cta">
        <h2>Thinking About Extending Your Home?</h2>

        <p>
            Contact us today to discuss your project and request a
            free, no-obligation quotation.
        </p>

        <a href="/contact">Request a Free Quote</a>
    </div>

</section>

</main>

<Footer />

</Layout>

<style>
.hero{
    background:#111;
    color:#fff;
    text-align:center;
    padding:110px 10% 80px;
}

.hero h1{
    font-size:3rem;
    margin-bottom:20px;
}

.hero p{
    color:#ddd;
    font-size:1.2rem;
}

.content{
    max-width:1000px;
    margin:auto;
    padding:80px 10%;
}

.content h2{
    margin-top:45px;
    margin-bottom:20px;
    font-size:2rem;
}

.content p{
    line-height:1.8;
    color:#555;
}

.services{
    display:grid;
    grid-template-columns:repeat(2,1fr);
    gap:25px;
    margin-top:35px;
}

.services div{
    padding:30px;
    border:1px solid #eee;
    border-radius:10px;
}

.services h3{
    margin-top:0;
}

.cta{
    margin-top:60px;
    padding:50px 30px;
    background:#111;
    color:#fff;
    text-align:center;
    border-radius:10px;
}

.cta h2{
    margin-top:0;
}

.cta p{
    color:#ddd;
    margin-bottom:25px;
}

.cta a{
    display:inline-block;
    background:#d97b18;
    color:#fff;
    text-decoration:none;
    padding:14px 30px;
    border-radius:6px;
    font-weight:bold;
}

@media(max-width:700px){
    .services{
        grid-template-columns:1fr;
    }

    .hero h1{
        font-size:2.2rem;
    }
}
</style>