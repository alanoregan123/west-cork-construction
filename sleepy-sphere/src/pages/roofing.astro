---
import Layout from "../layouts/Layout.astro";
import Navbar from "../components/Navbar.astro";
import Footer from "../components/Footer.astro";
---

<Layout
    title="Roofing Services West Cork | Roof Repairs & New Roofs"
    description="Roofing services throughout West Cork including roof repairs, new roofs, chimney repairs, gutters, fascias and soffits."
>

<Navbar />

<main>

<section class="hero">
    <h1>Roofing Services in West Cork</h1>
    <p>Roof repairs, maintenance and new roofing throughout West Cork.</p>
</section>

<section class="content">

    <h2>Professional Roofing Services</h2>

    <p>
        West Cork Construction & Maintenance Ltd provides reliable roofing
        services for homeowners and properties throughout West Cork.
        Whether you need a small repair, storm damage repaired or a complete
        new roof, we can help.
    </p>

    <div class="services">

        <div>
            <h3>🏠 Roof Repairs</h3>
            <p>
                Repairs to damaged, leaking and worn roofs to help protect
                your property from further damage.
            </p>
        </div>

        <div>
            <h3>🔨 New Roofs</h3>
            <p>
                Professional new roof construction and replacement work
                for residential properties.
            </p>
        </div>

        <div>
            <h3>🧱 Chimney Repairs</h3>
            <p>
                Repairs and maintenance to damaged or weathered chimneys.
            </p>
        </div>

        <div>
            <h3>💧 Gutters & Downpipes</h3>
            <p>
                Gutter and downpipe repairs and replacement to keep rainwater
                flowing away from your property.
            </p>
        </div>

        <div>
            <h3>🏡 Fascias & Soffits</h3>
            <p>
                Replacement and repair of damaged fascias and soffits.
            </p>
        </div>

        <div>
            <h3>🌧️ Storm Damage</h3>
            <p>
                Assistance with roofing damage caused by severe weather.
            </p>
        </div>

    </div>

    <h2>Roofers Covering West Cork</h2>

    <p>
        We provide roofing services throughout
        <strong>Clonakilty, Skibbereen, Rosscarbery, Dunmanway, Bandon,
        Glandore, Leap, Castletownshend and Enniskeane</strong> and
        surrounding areas.
    </p>

    <div class="cta">
        <h2>Need a Roof Repair?</h2>
        <p>
            Contact us today for a free, no-obligation quotation.
        </p>
        <a href="/contact">Request a Free Quote</a>
    </div>

</section>

</main>

<Footer />

</Layout>

<style>
.hero{
    background:#111;
    color:#fff;
    text-align:center;
    padding:110px 10% 80px;
}

.hero h1{
    font-size:3rem;
    margin-bottom:20px;
}

.hero p{
    color:#ddd;
    font-size:1.2rem;
}

.content{
    max-width:1000px;
    margin:auto;
    padding:80px 10%;
}

.content h2{
    margin-top:45px;
    margin-bottom:20px;
    font-size:2rem;
}

.content p{
    line-height:1.8;
    color:#555;
}

.services{
    display:grid;
    grid-template-columns:repeat(2,1fr);
    gap:25px;
    margin-top:35px;
}

.services div{
    padding:30px;
    border:1px solid #eee;
    border-radius:10px;
}

.services h3{
    margin-top:0;
}

.cta{
    margin-top:60px;
    padding:50px 30px;
    background:#111;
    color:#fff;
    text-align:center;
    border-radius:10px;
}

.cta h2{
    margin-top:0;
}

.cta p{
    color:#ddd;
    margin-bottom:25px;
}

.cta a{
    display:inline-block;
    background:#d97b18;
    color:#fff;
    text-decoration:none;
    padding:14px 30px;
    border-radius:6px;
    font-weight:bold;
}

@media(max-width:700px){
    .services{
        grid-template-columns:1fr;
    }

    .hero h1{
        font-size:2.2rem;
    }
}
</style>